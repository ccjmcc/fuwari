---
import MemoryPanel from "@/components/MemoryPanel.astro";
import { memosConfig, siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import {
	fetchMemosAsMemoryEntries,
	mapPostsToMemoryEntries,
} from "@/utils/memory-utils";
import { url } from "@/utils/url-utils";

const posts = await getSortedPosts();
const postEntries = await mapPostsToMemoryEntries(posts);
const memosFeed = await fetchMemosAsMemoryEntries();
const usingMemos = memosFeed.hasMemosSource;
const memoryEntries = usingMemos ? memosFeed.entries : postEntries;
const memoryTitle = "随笔";
const description = usingMemos
	? "随时在 Memos 记录碎片想法，再生成静态随笔时间线，方便浏览，也便于搜索引擎抓取。"
	: "把博客文章整理成轻量时间线，按时间、标签和封面快速浏览。";
const memoryUrl = Astro.site
	? new URL(url("/memory/"), Astro.site).href
	: url("/memory/");
const siteHomeUrl = Astro.site ? new URL(url("/"), Astro.site).href : url("/");
const siteLanguage = siteConfig.lang.replace(/_/g, "-");
const websiteId = Astro.site
	? `${new URL(Astro.site).origin}#website`
	: undefined;

const memoryJsonLd = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: `${memoryTitle} - ${siteConfig.title}`,
	description,
	url: memoryUrl,
	inLanguage: siteLanguage,
	isPartOf: websiteId
		? {
				"@id": websiteId,
			}
		: undefined,
	mainEntity: {
		"@type": "ItemList",
		itemListOrder: "https://schema.org/ItemListOrderDescending",
		numberOfItems: memoryEntries.length,
		itemListElement: memoryEntries.map((entry, index) => ({
			"@type": "ListItem",
			position: index + 1,
			name: entry.title,
			url: Astro.site
				? new URL(entry.permalink, Astro.site).href
				: entry.permalink,
		})),
	},
};

const breadcrumbJsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: siteConfig.title,
			item: siteHomeUrl,
		},
		{
			"@type": "ListItem",
			position: 2,
			name: memoryTitle,
			item: memoryUrl,
		},
	],
};
---

<MainGridLayout title={memoryTitle} description={description}>
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(memoryJsonLd)}
	></script>
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(breadcrumbJsonLd)}
	></script>

	<MemoryPanel
		items={memoryEntries}
		usingMemos={usingMemos}
		memosHomeUrl={memosConfig.baseUrl}
	/>
</MainGridLayout>
