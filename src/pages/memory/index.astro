---
import MemoryPanel from "@/components/MemoryPanel.astro";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

const posts = [...(await getSortedPosts())].sort(
	(a, b) => b.data.published.getTime() - a.data.published.getTime(),
);
const description =
	"Turn site posts into a lighter timeline for quick browsing by time and tag.";
const memoryUrl = Astro.site
	? new URL(url("/memory/"), Astro.site).href
	: url("/memory/");
const siteHomeUrl = Astro.site ? new URL(url("/"), Astro.site).href : url("/");
const siteLanguage = siteConfig.lang.replace(/_/g, "-");
const websiteId = Astro.site ? `${new URL(Astro.site).origin}#website` : undefined;

const memoryJsonLd = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: `Memory - ${siteConfig.title}`,
	description,
	url: memoryUrl,
	inLanguage: siteLanguage,
	isPartOf: websiteId
		? {
				"@id": websiteId,
			}
		: undefined,
	mainEntity: {
		"@type": "ItemList",
		itemListOrder: "https://schema.org/ItemListOrderDescending",
		numberOfItems: posts.length,
		itemListElement: posts.map((entry, index) => ({
			"@type": "ListItem",
			position: index + 1,
			name: entry.data.title,
			url: Astro.site
				? new URL(url(`/posts/${entry.slug}/`), Astro.site).href
				: url(`/posts/${entry.slug}/`),
		})),
	},
};

const breadcrumbJsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: siteConfig.title,
			item: siteHomeUrl,
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "Memory",
			item: memoryUrl,
		},
	],
};
---

<MainGridLayout title="Memory" description={description}>
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(memoryJsonLd)}
	></script>
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(breadcrumbJsonLd)}
	></script>

	<MemoryPanel entries={posts} />
</MainGridLayout>
