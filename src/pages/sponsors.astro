---
import { siteConfig } from "@/config";
import type { Sponsor } from "@/types/data";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

const sponsors = Object.values(
	import.meta.glob<Sponsor>("@/data/sponsors/*.json", {
		eager: true,
		import: "default",
	}),
);
---

<MainGridLayout title="赞助支持">
	<div class="card-base p-6 md:p-8">
		<div class="flex items-center gap-2 mb-6">
			<div class="h-8 w-8 rounded-lg bg-[var(--primary)] flex items-center justify-center text-white dark:text-black/70">
				<Icon name="material-symbols:favorite"></Icon>
			</div>
			<h1 class="text-2xl font-bold text-black dark:text-white">赞助支持</h1>
		</div>

		<p class="text-black/80 dark:text-white/80 mb-2">
			如果你觉得我的内容有帮助，欢迎通过下面方式支持我继续创作。
		</p>
		<p class="text-sm text-black/60 dark:text-white/60 mb-6">
			赞助将用于站点维护、服务器费用和内容产出。
		</p>

		<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8 max-w-4xl mx-auto">
			<div class="donate-card">
				<div class="flex items-center gap-3 mb-4">
					<div class="h-10 w-10 rounded-lg bg-blue-500 flex items-center justify-center">
						<Icon name="simple-icons:alipay" class="text-[1.2rem] text-white"></Icon>
					</div>
					<div>
						<h3 class="text-lg font-bold text-black dark:text-white">支付宝</h3>
						<p class="text-sm text-black/60 dark:text-white/60">扫码赞助</p>
					</div>
				</div>
				<div class="relative w-48 h-48 mx-auto rounded-lg overflow-hidden" style={`--theme-hue: ${siteConfig.themeColor.hue}`}>
					<img src="/sponsors/alipay.svg" alt="支付宝收款码" class="w-full h-full object-cover transition duration-500" />
				</div>
			</div>

			<div class="donate-card">
				<div class="flex items-center gap-3 mb-4">
					<div class="h-10 w-10 rounded-lg bg-green-500 flex items-center justify-center">
						<Icon name="simple-icons:wechat" class="text-[1.2rem] text-white"></Icon>
					</div>
					<div>
						<h3 class="text-lg font-bold text-black dark:text-white">微信支付</h3>
						<p class="text-sm text-black/60 dark:text-white/60">扫码赞助</p>
					</div>
				</div>
				<div class="relative w-48 h-48 mx-auto rounded-lg overflow-hidden" style={`--theme-hue: ${siteConfig.themeColor.hue}`}>
					<img src="/sponsors/wechat.svg" alt="微信收款码" class="w-full h-full object-cover transition duration-500" />
				</div>
			</div>
		</div>

		<div class="card-base p-6 mb-6">
			<h2 class="text-xl font-bold text-black dark:text-white mb-3">其他支持方式</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
				<div class="support-card">
					<div class="flex items-center gap-2 mb-2">
						<Icon name="material-symbols:share" class="text-[1.2rem] text-[var(--primary)]"></Icon>
						<span class="font-semibold text-black dark:text-white">分享推荐</span>
					</div>
					<p class="text-sm text-black/60 dark:text-white/60">把博客分享给更多朋友。</p>
				</div>
				<div class="support-card">
					<div class="flex items-center gap-2 mb-2">
						<Icon name="material-symbols:comment" class="text-[1.2rem] text-[var(--primary)]"></Icon>
						<span class="font-semibold text-black dark:text-white">留言互动</span>
					</div>
					<p class="text-sm text-black/60 dark:text-white/60">在文章下方留下你的想法。</p>
				</div>
				<div class="support-card">
					<div class="flex items-center gap-2 mb-2">
						<Icon name="material-symbols:star" class="text-[1.2rem] text-[var(--primary)]"></Icon>
						<span class="font-semibold text-black dark:text-white">关注订阅</span>
					</div>
					<p class="text-sm text-black/60 dark:text-white/60">订阅 RSS 或关注社媒。</p>
				</div>
			</div>
		</div>

		<div class="sponsors-section card-base p-6">
			<h2 class="text-xl font-bold text-black dark:text-white mb-3 flex items-center gap-2">
				<Icon name="material-symbols:group" class="text-[1.5rem] text-[var(--primary)]"></Icon>
				<span>已赞助的小伙伴</span>
			</h2>
			<p class="text-sm text-black/60 dark:text-white/60 mb-4">
				如果你已赞助并希望加入名单，请提交 JSON 到
				<a
					target="_blank"
					href="https://github.com/ccjmcc/fuwari/tree/main/src/data/sponsors"
					class="transition link text-[var(--primary)] font-medium underline"
				>
					src/data/sponsors
				</a>
			</p>

			{ sponsors.length === 0 ? (
				<p class="text-sm text-black/50 dark:text-white/50">暂无赞助记录。</p>
			) : (
				<div class="sponsors-grid">
					{sponsors.map((sponsor) => (
						<div class="sponsor-card">
							<div class="flex items-center gap-3 p-4 rounded-lg bg-[var(--card-bg)] border border-black/10 dark:border-white/10">
								<div class="w-10 h-10 rounded-lg flex items-center justify-center overflow-hidden">
									{sponsor.avatar ? (
										<div class="relative w-full h-full rounded-lg overflow-hidden" style={`--theme-hue: ${siteConfig.themeColor.hue}`}>
											<img src={sponsor.avatar} alt={`${sponsor.name} 的头像`} loading="lazy" class="w-full h-full object-cover transition duration-500" />
										</div>
									) : (
										<Icon name="material-symbols:person" class="text-gray-500 dark:text-gray-400 text-[1.2rem]" />
									)}
								</div>
								<div class="flex-1">
									<h4 class="font-semibold text-black dark:text-white text-sm">{sponsor.name}</h4>
									<p class="text-xs text-black/60 dark:text-white/60">{sponsor.date}</p>
								</div>
								<div class="text-xs text-[var(--primary)] font-medium">{sponsor.amount}</div>
							</div>
						</div>
					))}
				</div>
			)}
		</div>
	</div>
</MainGridLayout>

<style>
.donate-card {
	@apply flex flex-col p-4 rounded-lg bg-[var(--card-bg)] border border-black/10 dark:border-white/10 hover:border-black/20 dark:hover:border-white/20 transition;
	backdrop-filter: blur(12px);
	-webkit-backdrop-filter: blur(12px);
}

.support-card {
	@apply p-4 rounded-lg bg-[var(--card-bg)] border border-black/10 dark:border-white/10 hover:border-black/20 dark:hover:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 transition;
	backdrop-filter: blur(12px);
	-webkit-backdrop-filter: blur(12px);
}

.sponsors-section {
	@apply mt-6;
}

.sponsors-grid {
	@apply grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4;
}

.sponsor-card {
	@apply transition-all duration-200 hover:shadow-md hover:scale-105;
}
</style>
